<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Company>Arnav Games</Company>
    <Product>Arnav Games</Product>
    <Copyright>Copyright © 2026 Arnav Games contributors</Copyright>
    <!-- Overridden by the release pipeline (build/pack.ps1 -Version). -->
    <Version Condition="'$(Version)' == ''">0.1.0</Version>
  </PropertyGroup>
</Project>
